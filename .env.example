# ══════════════════════════════════════════════════════════════
#  文档转 PPT 生成器 —— 环境变量模板
#
#  用法：cp .env.example .env  然后填 key
#  代码只读 .env（不读本文件）；本文件可安全提交到仓库。
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
#  1. 文本模型 —— 用于「解析内容 → 生成大纲 → 规划每页版式」
#     任何 OpenAI 兼容的 /chat/completions 端点都可以。
# ──────────────────────────────────────────────────────────────
PPTGEN_LLM_BASE_URL=
PPTGEN_LLM_API_KEY=
PPTGEN_LLM_MODEL=

# 常见服务商填法（复制其中一组到上面三行即可）
#
#   智谱 GLM（z.ai）
#     PPTGEN_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#     PPTGEN_LLM_MODEL=glm-4-plus
#
#   DeepSeek
#     PPTGEN_LLM_BASE_URL=https://api.deepseek.com/v1
#     PPTGEN_LLM_MODEL=deepseek-chat
#
#   阿里通义千问
#     PPTGEN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     PPTGEN_LLM_MODEL=qwen-max
#
#   OpenAI
#     PPTGEN_LLM_BASE_URL=https://api.openai.com/v1
#     PPTGEN_LLM_MODEL=gpt-4o
#
#   本地 Ollama / vLLM
#     PPTGEN_LLM_BASE_URL=http://localhost:11434/v1
#     PPTGEN_LLM_MODEL=qwen2.5:14b

# ──────────────────────────────────────────────────────────────
#  2. 视觉模型 —— 用于「AI 看图」验收（把渲染出的页面图交给它判定）
#     必须支持 image_url（base64 data URI）输入。
# ──────────────────────────────────────────────────────────────
PPTGEN_VISION_BASE_URL=
PPTGEN_VISION_API_KEY=
PPTGEN_VISION_MODEL=

# 常见填法
#
#   OpenAI
#     PPTGEN_VISION_MODEL=gpt-4o
#   智谱 GLM
#     PPTGEN_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#     PPTGEN_VISION_MODEL=glm-4v-plus
#   阿里通义
#     PPTGEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     PPTGEN_VISION_MODEL=qwen-vl-max
#   Azure OpenAI（注意 URL 与 api-version 的写法）
#     PPTGEN_VISION_BASE_URL=https://<资源名>.openai.azure.com/openai/deployments/<部署名>
#     PPTGEN_VISION_MODEL=<部署名>
#     PPTGEN_VISION_API_VERSION=2024-08-01-preview

# 视觉模型留空时是否回退用文本模型的配置（同一家的模型常共用 key）
#   1 = 回退（默认）；0 = 不回退，直接输出人工复核包
PPTGEN_VISION_FALLBACK_TO_LLM=1

# Azure OpenAI 专用：若填了 api-version，请求会走 Azure 的 URL 与鉴权头
PPTGEN_LLM_API_VERSION=
PPTGEN_VISION_API_VERSION=

# ──────────────────────────────────────────────────────────────
#  3. 生成参数
# ──────────────────────────────────────────────────────────────
# 正文页数区间（含端点）—— 会作为硬约束写进规划提示词
PPTGEN_MIN_PAGES=13
PPTGEN_MAX_PAGES=18

# 单次请求超时（秒）
PPTGEN_TIMEOUT=180

# 调用失败重试次数
PPTGEN_RETRY=2

# 输出目录（相对项目根目录）
PPTGEN_OUT=out

# ──────────────────────────────────────────────────────────────
#  4. 内容取舍策略 —— 源文档很长时的提炼口径
# ──────────────────────────────────────────────────────────────
# strict  = 只做结构整理，尽量不增删原文事实
# balance = 允许提炼与合并，但数字/专有名词/结论句必须保留（默认）
# enrich  = 允许基于常识补写过渡与解释
PPTGEN_CONTENT_MODE=balance

# ──────────────────────────────────────────────────────────────
#  5. 模板
# ──────────────────────────────────────────────────────────────
PPTGEN_TEMPLATE=迈胜PPT模板.pptx

# 单次生成的最大输出 token。
# ⚠️ 推理模型（deepseek-flash / deepseek-reasoner / o1 等）会把大量 token 花在
#    推理上，给少了正文会为空（表现为「模型只产出了推理内容」）。建议 ≥8000。
PPTGEN_MAX_TOKENS=8000
