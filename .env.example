# ══════════════════════════════════════════════════════════════
#  文档转 PPT 生成器 —— 环境变量模板
#
#  用法：cp .env.example .env  然后填 key
#  代码只读 .env（不读本文件）；本文件可安全提交到仓库。
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
#  1. 文本模型 —— 用于「解析内容 → 生成大纲 → 规划每页版式」
#     任何 OpenAI 兼容的 /chat/completions 端点都可以。
# ──────────────────────────────────────────────────────────────
PPTGEN_LLM_BASE_URL=
PPTGEN_LLM_API_KEY=
PPTGEN_LLM_MODEL=

# 常见服务商填法（复制其中一组到上面三行即可）
#
#   智谱 GLM（z.ai）
#     PPTGEN_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#     PPTGEN_LLM_MODEL=glm-4-plus
#
#   DeepSeek
#     PPTGEN_LLM_BASE_URL=https://api.deepseek.com/v1
#     PPTGEN_LLM_MODEL=deepseek-chat
#
#   阿里通义千问
#     PPTGEN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     PPTGEN_LLM_MODEL=qwen-max
#
#   OpenAI
#     PPTGEN_LLM_BASE_URL=https://api.openai.com/v1
#     PPTGEN_LLM_MODEL=gpt-4o
#
#   本地 Ollama / vLLM
#     PPTGEN_LLM_BASE_URL=http://localhost:11434/v1
#     PPTGEN_LLM_MODEL=qwen2.5:14b

# ──────────────────────────────────────────────────────────────
#  2. 视觉模型 —— 用于「AI 看图」验收（把渲染出的页面图交给它判定）
#     必须支持 image_url（base64 data URI）输入。
# ──────────────────────────────────────────────────────────────
PPTGEN_VISION_BASE_URL=
PPTGEN_VISION_API_KEY=
PPTGEN_VISION_MODEL=

# 常见填法
#
#   OpenAI
#     PPTGEN_VISION_MODEL=gpt-4o
#   智谱 GLM
#     PPTGEN_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#     PPTGEN_VISION_MODEL=glm-4v-plus
#   阿里通义
#     PPTGEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     PPTGEN_VISION_MODEL=qwen-vl-max
#   Azure OpenAI（注意 URL 与 api-version 的写法）
#     PPTGEN_VISION_BASE_URL=https://<资源名>.openai.azure.com/openai/deployments/<部署名>
#     PPTGEN_VISION_MODEL=<部署名>
#     PPTGEN_VISION_API_VERSION=2024-08-01-preview

# 视觉模型留空时是否回退用文本模型的配置（同一家的模型常共用 key）
#   1 = 回退（默认）；0 = 不回退，直接输出人工复核包
PPTGEN_VISION_FALLBACK_TO_LLM=1

# Azure OpenAI 专用：若填了 api-version，请求会走 Azure 的 URL 与鉴权头
PPTGEN_LLM_API_VERSION=
PPTGEN_VISION_API_VERSION=

# ──────────────────────────────────────────────────────────────
#  3. 生成参数
# ──────────────────────────────────────────────────────────────
# 正文页数区间（含端点）—— 会作为硬约束写进规划提示词。
# 注意：**章节分隔页不占这个额度**，它由下面那个开关单独控制。
PPTGEN_MIN_PAGES=13
PPTGEN_MAX_PAGES=18

# 是否在正文里插入章节分隔页（每章开头一页：大号章节号 + 章节名 + 一句导语）。
# 1 = 插（默认），0 = 不插。
# 它让「换章了」在翻页时可见 —— 不插的话，5 个章节只靠左上角那行 kicker 区分。
# 要占页数预算，所以只在「扣掉之后每章还留得下一页正文」时才插；装不下就完全不插。
PPTGEN_SECTION_DIVIDERS=1

# 骨架分不出章（或分得太碎）时，是否让模型把「页单元」归成几章。
# 1 = 允许（默认），0 = 关掉（退回纯确定性，一次模型调用都不多花）。
# 只在这两种情况下触发：整份文档只剩 1 章、或章数超过 min(7, 页数上限 ÷ 2)。
# 模型返回的分组会被严格校验（区间必须首尾相接、覆盖全部页单元），不合格整份丢弃。
PPTGEN_OUTLINE_SEGMENT=1

# 单次请求超时（秒）
PPTGEN_TIMEOUT=180

# 调用失败重试次数
PPTGEN_RETRY=2

# 输出目录（相对项目根目录）
PPTGEN_OUT=out

# Web 结果区逐页预览图的渲染分辨率。
# 1920x1080 是 officecli native 渲染的上限，再往大传也只出这个尺寸。
# 调小只省磁盘 —— 渲染耗时取决于 PowerPoint 起进程，跟分辨率无关。
# 只影响 Web 预览；AI 看图复核那一路固定 1280x720（那些图要进视觉模型，
# 放大像素等于放大请求体积）。改了这里，旧的渲染图会自动失效重渲一次。
PPTGEN_PREVIEW_WIDTH=1920
PPTGEN_PREVIEW_HEIGHT=1080

# ──────────────────────────────────────────────────────────────
#  4. 内容取舍策略 —— 源文档很长时的提炼口径
# ──────────────────────────────────────────────────────────────
# strict  = 只做结构整理，尽量不增删原文事实
# balance = 允许提炼与合并，但数字/专有名词/结论句必须保留（默认）
# enrich  = 允许基于常识补写过渡与解释
PPTGEN_CONTENT_MODE=balance

# ──────────────────────────────────────────────────────────────
#  5. 模板
# ──────────────────────────────────────────────────────────────
PPTGEN_TEMPLATE=迈胜PPT模板.pptx

# 单次生成的最大输出 token。
# ⚠️ 推理模型（deepseek-flash / deepseek-reasoner / o1 等）会把大量 token 花在
#    推理上，给少了正文会为空（表现为「模型只产出了推理内容」）。建议 ≥8000。
PPTGEN_MAX_TOKENS=8000

# ── 分阶段输出上限（一般留空，按下面的规则自动派生）──────────────────
# 大纲与规划都是「一次要吐好几千 token JSON」的调用，而推理模型**会撑满给定
# 的额度**：实测给 4000 就烧掉 4001、给 8000 就烧掉 8000，正文一律为空 ——
# 而正文为空会被兜底静默吞掉，表现成「大纲质量就是这么差」，非常难查。
#
# 留空时取 max(PPTGEN_MAX_TOKENS, 16000)。只有确实要压额度（省钱 / 服务商
# 限制）时才显式填，填了就以你为准。
PPTGEN_OUTLINE_MAX_TOKENS=
PPTGEN_PLAN_MAX_TOKENS=

# ── 按页修订（`run.py revise` / 网页上的「按页修改」）──────────────
# 一次提交里最多**整页重做**几页。存在的理由是 llm 那条路没有取消接口：
# 单次调用最坏 3×PPTGEN_TIMEOUT + 退避 ≈ 9 分钟，而重做是**一页一次**调用 ——
# 用户写「第 3、5、7、9、11 页都重做」就是 5 次，最坏 45 分钟且中途停不下来。
# 超出的条目不会被静默丢掉：会明确回一条「本次没做，请再提交一次」。
# 「小范围修改」不受这个上限影响（所有条目合并成一次调用）。
PPTGEN_REVISE_MAX_PAGES=3

# ──────────────────────────────────────────────────────────────
#  6. 文件日志 —— 每跑一次流程留一个可回看的文件夹
# ──────────────────────────────────────────────────────────────
# 每次流程在下面这个目录里建一个 `<年-月-日-时-分>-<任务名>/`，内含：
#   run.json   本次流程的关键值（源与结构 / 各阶段耗时与降级 / QA 结果 / 配置快照）
#   run.log    完整流水（CLI 的 stdout、Web 的任务日志），失败时 traceback 也在
#   <成品>.pptx 生成的 pptx
#   <源文件>   仅当源是**上传**的才放；用根目录文件时不放（源就在仓库里）
#
# 置 0 可整体关闭（跑批量脚本时有用）。
PPTGEN_LOG=1

# 日志根目录。留空 = `<输出目录>/logs`。改动它会把新日志写到别处，
# 已有的历史日志留在原地。
PPTGEN_LOG_DIR=

# 单个文件超过这个大小就只记路径 + sha256，不复制进日志文件夹。
# Web 上传有 40MB 上限，但 CLI 没有 —— 不兜底的话
# `run.py full --src <500MB 的 pdf>` 会把它整个复制进来。
PPTGEN_LOG_MAX_COPY_MB=64

# 成品 pptx 要不要复制进日志文件夹：copy（默认）/ none
# 一份约 8MB（内嵌模板图片），介意占地方就设 none，run.json 里仍记 sha256。
PPTGEN_LOG_PPTX=copy
